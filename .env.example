# ==============================================================================
# Hotel OS — Environment Variables
# ==============================================================================
# Copy this file to .env and fill in the values for your environment.
# Never commit your .env file to version control.
# ==============================================================================

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hotel_os?schema=public"

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── API Server ────────────────────────────────────────────────────────────────
API_PORT=4000
API_HOST=0.0.0.0
NODE_ENV=development

# ── Authentication / JWT ──────────────────────────────────────────────────────
JWT_SECRET="change-me-to-a-random-secret"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="change-me-to-another-random-secret"
JWT_REFRESH_EXPIRES_IN="30d"

# ── Web / Next.js ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-nextauth-secret"
NEXTAUTH_URL="http://localhost:3000"

# ── AI Engine (FastAPI) ───────────────────────────────────────────────────────
AI_ENGINE_URL="http://localhost:8000"
AI_ENGINE_API_KEY="change-me-ai-engine-key"

# ── Email / SMTP ──────────────────────────────────────────────────────────────
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@hotel-os.dev"

# ── File Storage (S3-compatible) ──────────────────────────────────────────────
STORAGE_ENDPOINT=""
STORAGE_BUCKET="hotel-os"
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_REGION="us-east-1"

# ── Stripe (Payments) ────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL="debug"
LOG_FORMAT="pretty"

# ── Rate Limiting ─────────────────────────────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS="http://localhost:3000"
