{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node",
    "outDir": "./dist",
    "baseUrl": "./",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strictPropertyInitialization": false,
    "declaration": false,
    "declarationMap": false,
    "incremental": true,
    "paths": {
      "@/*": ["./src/*"],
      "@hotel-os/shared": ["../../packages/shared/src/index.ts"],
      "@hotel-os/database": ["../../packages/database/src/index.ts"],
      "@hotel-os/ui": ["../../packages/ui/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "test"]
}
