{
  "name": "hotel-os",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "type-check": "turbo run type-check",
    "db:generate": "npm run generate -w @hotel-os/database",
    "db:push": "npm run push -w @hotel-os/database",
    "db:seed": "npm run seed -w @hotel-os/database",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  },
  "engines": { "node": ">=20" },
  "packageManager": "npm@11.17.0"
}
